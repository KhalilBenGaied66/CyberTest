# Copy to .env, fill in, and load with:  set -a; . ./.env; set +a
# Never commit .env.

# HTTP API bearer token (random, >= 24 characters):  python -c "import secrets; print(secrets.token_urlsafe(32))"
SOAR_API_TOKEN=

SOAR_DATA_DIR=data/runtime
SOAR_POLICY_FILE=config/lab-policy.json
# Comma-separated; add data/ioc/threatfox_mirror.jsonl once refresh_ioc_mirror.py has run
SOAR_IOC_PATHS=data/ioc/local_iocs.seed.jsonl

# Only "simulate" is implemented
RESPONSE_MODE=simulate
SOAR_OFFLINE=false
# Lab fixtures use RFC 5737 documentation IPs; this lets them be enriched and (simulated-)blocked.
# Never enable outside the synthetic lab.
SOAR_LAB_DOC_RANGES_ROUTABLE=true

# Free abuse.ch Auth-Keys. Missing key => provider reported as unknown, never clean.
URLHAUS_AUTH_KEY=
THREATFOX_AUTH_KEY=

# Optional VirusTotal report lookups (never uploads)
VT_ENABLED=false
VT_API_KEY=
VT_PER_MINUTE=3
VT_PER_DAY=100

SOAR_APPROVAL_TIMEOUT_SECONDS=1800
SOAR_BLOCK_TTL_SECONDS=3600
SOAR_DEDUPE_WINDOW_SECONDS=86400

# file (data/runtime/notifications/outbox.jsonl) or smtp (e.g. Mailpit)
SOAR_NOTIFY_MODE=file
SOAR_SMTP_HOST=localhost
SOAR_SMTP_PORT=1025
SOAR_NOTIFY_FROM=soar@lab.example
SOAR_ANALYST_ADDRESS=analyst@lab.example
